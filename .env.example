# Copy to .env.local and fill in. Never commit .env.local.
FORTYGUARD_API_KEY=
FORTYGUARD_TIER=BASIC
GOOGLE_GENAI_API_KEY=

# Postgres connection string. Required — accounts, buildings, and reports
# are stored here. A free instance (e.g. Neon) is enough for this project's scale.
DATABASE_URL=

# Session signing, required by NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional. Without these, sign-in falls back to a clearly labeled demo mode
# that accepts any email and verifies nothing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
